import java.io.*;
import java.util.*;
import java.util.stream.*;

class Result {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int numRings = Math.min(m, n) / 2;

        for (int ring = 0; ring < numRings; ring++) {
            List<int[]> coords = new ArrayList<>();

            // 1. Top row (left to right)
            for (int j = ring; j < n - ring; j++) {
                coords.add(new int[]{ring, j});
            }

            // 2. Right column (top to bottom)
            for (int i = ring + 1; i < m - ring; i++) {
                coords.add(new int[]{i, n - 1 - ring});
            }

            // 3. Bottom row (right to left)
            for (int j = n - 2 - ring; j >= ring; j--) {
                coords.add(new int[]{m - 1 - ring, j});
            }

            // 4. Left column (bottom to top)
            for (int i = m - 2 - ring; i > ring; i--) {
                coords.add(new int[]{i, ring});
            }

            int totalElements = coords.size();
            int[] values = new int[totalElements];

            // Read original values along the perimeter ring (clockwise order)
            for (int k = 0; k < totalElements; k++) {
                int[] pos = coords.get(k);
                values[k] = matrix.get(pos[0]).get(pos[1]);
            }

            int effR = r % totalElements;

            // Rotating anti-clockwise by effR means index k gets value from (k + effR) % totalElements
            for (int k = 0; k < totalElements; k++) {
                int[] pos = coords.get(k);
                int oldIndex = (k + effR) % totalElements;
                matrix.get(pos[0]).set(pos[1], values[oldIndex]);
            }
        }

        // Print final matrix
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(matrix.get(i).get(j)).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb);
    }
}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        IntStream.range(0, m).forEach(i -> {
            try {
                matrix.add(
                    Stream.of(bufferedReader.readLine().replaceAll("\\s+$", "").split(" "))
                        .map(Integer::parseInt)
                        .collect(Collectors.toList())
                );
            } catch (IOException ex) {
                throw new RuntimeException(ex);
            }
        });

        Result.matrixRotation(matrix, r);
        bufferedReader.close();
    }
}
