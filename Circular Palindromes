import java.io.*;
import java.util.*;

public class Solution {

    static int[] radius;
    static int[][] sparse;
    static int[] log;

    // Manacher's algorithm
    static void manacher(int[] a) {
        int n = a.length;

        radius = new int[n];

        int center = 0;
        int right = 0;

        for (int i = 0; i < n; i++) {

            if (i < right) {
                radius[i] = Math.min(
                    radius[2 * center - i],
                    right - i
                );
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < n &&
                   a[i - radius[i] - 1] ==
                   a[i + radius[i] + 1]) {

                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
    }

    // Build Sparse Table for range maximum
    static void buildSparseTable() {
        int n = radius.length;

        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int k = log[n] + 1;

        sparse = new int[k][n];

        for (int i = 0; i < n; i++) {
            sparse[0][i] = radius[i];
        }

        for (int j = 1; j < k; j++) {
            int len = 1 << j;
            int half = len >> 1;

            for (int i = 0; i + len <= n; i++) {
                sparse[j][i] = Math.max(
                    sparse[j - 1][i],
                    sparse[j - 1][i + half]
                );
            }
        }
    }

    // Range maximum query
    static int rangeMax(int left, int right) {

        if (left > right) {
            return 0;
        }

        int length = right - left + 1;
        int k = log[length];

        return Math.max(
            sparse[k][left],
            sparse[k][right - (1 << k) + 1]
        );
    }

    static int[] circularPalindromes(String s) {

        int n = s.length();

        /*
         * Duplicate the string.
         *
         * Example:
         * abcde
         *
         * becomes:
         * abcdeabcde
         */
        String doubled = s + s;

        /*
         * Transform:
         *
         * abc
         *
         * becomes:
         *
         * #a#b#c#
         *
         * We use 26 as the separator.
         */
        int[] transformed = new int[2 * doubled.length() + 1];

        for (int i = 0; i < transformed.length; i++) {
            if (i % 2 == 0) {
                transformed[i] = 26;
            } else {
                transformed[i] =
                    doubled.charAt(i / 2) - 'a';
            }
        }

        // Find palindrome radius around every center
        manacher(transformed);

        // Build RMQ
        buildSparseTable();

        int[] answer = new int[n];

        /*
         * Each rotation corresponds to a window of
         * n characters in the doubled string.
         *
         * Character positions in transformed string
         * are odd:
         *
         * 1, 3, 5, 7, ...
         */
        for (int start = 0; start < n; start++) {

            int left = 2 * start + 1;

            int right = 2 * (start + n - 1) + 1;

            /*
             * Binary search the answer.
             */
            int low = 1;
            int high = n;
            int best = 1;

            while (low <= high) {

                int mid = (low + high) / 2;

                /*
                 * A palindrome of length mid must have
                 * its center somewhere between:
                 *
                 * left + mid - 1
                 * and
                 * right - mid + 1
                 *
                 * in the transformed string.
                 */
                int queryLeft = left + mid - 1;
                int queryRight = right - mid + 1;

                if (queryLeft <= queryRight &&
                    rangeMax(queryLeft, queryRight) >= mid) {

                    best = mid;
                    low = mid + 1;

                } else {
                    high = mid - 1;
                }
            }

            answer[start] = best;
        }

        return answer;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(
                new InputStreamReader(System.in)
            );

        int n = Integer.parseInt(
            br.readLine().trim()
        );

        String s = br.readLine().trim();

        int[] result = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int x : result) {
            out.append(x).append('\n');
        }

        System.out.print(out);
    }
}
