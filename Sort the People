import java.util.*;

class Solution {
    public String[] sortPeople(String[] names, int[] heights) {
        int n = names.length;
        
        // Map height -> name (since all heights are distinct)
        Map<Integer, String> map = new HashMap<>();
        for (int i = 0; i < n; i++) {
            map.put(heights[i], names[i]);
        }
        
        // Sort heights array in ascending order
        Arrays.sort(heights);
        
        // Traverse backwards to fill result in descending order
        String[] result = new String[n];
        for (int i = 0; i < n; i++) {
            result[i] = map.get(heights[n - 1 - i]);
        }
        
        return result;
    }
}
