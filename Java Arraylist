import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Read the number of lines
        int n = scanner.nextInt();
        
        // Use an ArrayList of ArrayLists to store the 2D dynamic data
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt(); // number of elements in current line
            ArrayList<Integer> line = new ArrayList<>();
            
            for (int j = 0; j < d; j++) {
                line.add(scanner.nextInt());
            }
            
            lines.add(line);
        }

        // Read the number of queries
        int q = scanner.nextInt();

        // Process each query
        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // 1-based line number
            int y = scanner.nextInt(); // 1-based position in line

            // Convert 1-based index to 0-based index
            int lineIndex = x - 1;
            int elementIndex = y - 1;

            // Check if indices are within valid range
            if (lineIndex >= 0 && lineIndex < lines.size()) {
                ArrayList<Integer> currentLine = lines.get(lineIndex);
                if (elementIndex >= 0 && elementIndex < currentLine.size()) {
                    System.out.println(currentLine.get(elementIndex));
                } else {
                    System.out.println("ERROR!");
                }
            } else {
                System.out.println("ERROR!");
            }
        }

        scanner.close();
    }
}
